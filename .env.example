# Opcional: si faltan, localhost usa el Firebase/API de development y
# vaiinilla.app / www usan production (los mismos clientes web del panel).
VITE_API_URL=https://vaiinillaback-development.up.railway.app/api/v1
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Solo para smoke interno. Debe ser false antes de abrir a usuarios reales.
VITE_ALLOW_UNPUBLISHED_LEGAL_TESTING=false

# Pública de Stripe. Opcional: el backend también puede devolver publishable_key.
# localhost / sand-user: pk_test_...   vaiinilla.app / www: pk_live_...
# Nunca pongas sk_ ni whsec_ aquí.
VITE_STRIPE_PUBLISHABLE_KEY=
