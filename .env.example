# Variables de la landing. Todas son públicas (van al bundle del navegador):
# nunca pongas aquí sk_, whsec_ ni otros secretos.
#
# - `npm run dev` usa .env.development (en el repo).
# - Vercel define cada ambiente en Settings → Environment Variables:
#     Production (main → www.vaiinilla.app): valores de production.
#     Preview (develop → sand-user.vaiinilla.app y PRs): valores de development.
# - Para sobreescribir algo en tu máquina, copia este archivo a .env.local.

# 'development' o 'production'. Decide qué clave de Stripe se acepta
# (pk_test_ en development, pk_live_ en production).
VITE_APP_ENV=development

# API del backend. development: https://vaiinillaback-development.up.railway.app/api/v1
#                  production:  https://vaiinillaback.up.railway.app/api/v1
VITE_API_URL=

# Cliente web de Firebase del mismo ambiente que el API.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional. Clave pública de Stripe; el backend también la devuelve por pedido.
VITE_STRIPE_PUBLISHABLE_KEY=

# Solo para smoke interno. Debe ser false antes de abrir a usuarios reales.
VITE_ALLOW_UNPUBLISHED_LEGAL_TESTING=false
